# Cocokin! — Environment Variables Template
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# JANGAN PERNAH menaruh API key / kredensial asli di file ini.

# NextAuth / Autentikasi Google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Supabase (Hosted PostgreSQL & API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini 2.5 Flash (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
